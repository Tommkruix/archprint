# Copy to deploy/cloud.conf and fill in. deploy/cloud.conf is gitignored and is the only place
# the project, region and account are recorded. Never commit it and never put these values in a
# tracked file. Nothing here is a secret; real secrets belong in Secret Manager.
PROJECT=your-project-id
REGION=us-central1
ACCOUNT=you@example.com
SERVICE=archprint-mcp
